# timekeep: restores the clock at boot from a battery-backed RTC, the vRTC's
# kept time or a saved last-known time, and saves the time every minute and at
# shutdown. It never touches the network.
#
# The board labels the vRTC's sysfs device directory sysfs_rtc in its own
# genfs_contexts (the path is per SoC), e.g. for GXL:
#   genfscon sysfs /devices/platform/soc/c8100000.bus/c81000a8.rtc u:object_r:sysfs_rtc:s0
type timekeep, domain;
type timekeep_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(timekeep)

type timekeep_data_file, file_type, data_file_type;

# One native binary; it runs nothing else.
allow timekeep timekeep_data_file:dir rw_dir_perms;
allow timekeep timekeep_data_file:file create_file_perms;

# The vRTC's kept time (/sys/class/rtc/rtcN/{name,since_epoch}).
allow timekeep sysfs_rtc:dir r_dir_perms;
allow timekeep sysfs_rtc:file r_file_perms;
allow timekeep sysfs_rtc:lnk_file read;

# A battery-backed RTC, when fitted (/dev/rtc0, rtc_device; system:system 0640 by
# the core ueventd.rc): read at restore (opened read-only, RTC_RD_TIME). Android's
# time detector, not this, writes it.
allow timekeep rtc_device:chr_file r_file_perms;

# The vendor image's build time (ro.vendor.build.date.utc), the floor of a
# plausible restored time. Without it the property reads empty, with no audit line.
get_prop(timekeep, build_vendor_prop)

# Setting the clock on restore (init grants SYS_TIME to the restore service only).
allow timekeep self:global_capability_class_set sys_time;
