// SPDX-License-Identifier: Apache-2.0
//
// timekeep: the clock started as close to real time as a board can know without a
// network -- a battery-backed RTC, the Amlogic vRTC's kept time, or a saved
// last-known time. A board adds `timekeep` to PRODUCT_PACKAGES and this
// project's sepolicy/ to BOARD_VENDOR_SEPOLICY_DIRS.

cc_defaults {
    name: "timekeep_defaults",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_library_static {
    name: "libtimekeep",
    defaults: ["timekeep_defaults"],
    vendor_available: true,
    host_supported: true,
    srcs: ["timekeep_core.cpp"],
    export_include_dirs: ["."],
}

cc_binary {
    name: "timekeep",
    defaults: ["timekeep_defaults"],
    vendor: true,
    srcs: ["main.cpp"],
    static_libs: ["libtimekeep"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    required: ["init.timekeep.rc"],
}

prebuilt_etc {
    name: "init.timekeep.rc",
    src: "init.timekeep.rc",
    vendor: true,
    relative_install_path: "init",
}

cc_test {
    name: "timekeep_test",
    defaults: ["timekeep_defaults"],
    host_supported: true,
    srcs: ["timekeep_test.cpp"],
    static_libs: ["libtimekeep"],
    shared_libs: ["libbase"],
}
