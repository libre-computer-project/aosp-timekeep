// SPDX-License-Identifier: Apache-2.0
//
// timekeep: the clock started as close to real time as a board can know without a
// network -- a battery-backed RTC, the Amlogic vRTC's kept time, or a saved
// last-known time. A board adds `timekeep` to PRODUCT_PACKAGES and this
// project's sepolicy/ to BOARD_VENDOR_SEPOLICY_DIRS.

sh_binary {
    name: "timekeep",
    src: "timekeep",
    vendor: true,
    required: ["init.timekeep.rc"],
}

prebuilt_etc {
    name: "init.timekeep.rc",
    src: "init.timekeep.rc",
    vendor: true,
    relative_install_path: "init",
}
